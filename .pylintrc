[MASTER]
ignore = venv,data,results,__pycache__,.git

[MESSAGES CONTROL]
# Project conventions and existing public APIs intentionally trigger these
# stylistic checks; correctness-oriented checks remain enabled.
disable =
    abstract-method,
    broad-exception-caught,
    import-outside-toplevel,
    line-too-long,
    logging-fstring-interpolation,
    missing-class-docstring,
    missing-final-newline,
    missing-function-docstring,
    redefined-outer-name,
    reimported,
    too-few-public-methods,
    too-many-arguments,
    too-many-instance-attributes,
    too-many-locals,
    too-many-positional-arguments,
    trailing-whitespace,
    unnecessary-negation,
    unused-argument,
    unused-variable,
    wrong-import-order,
    wrong-import-position

[FORMAT]
max-line-length = 140
